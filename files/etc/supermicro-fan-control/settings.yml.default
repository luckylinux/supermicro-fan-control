general:
    motherboard: "Supermicro_default"
    update_interval: 30
    environment:
        LC_TIME: "en_DK.UTF-8"
        LC_ALL: "en_DK.UTF-8"
    debug: False

log:
    general:
        level: "INFO"

    diskinfo:
        level: "INFO"

beep:
    frequency: 2500
    duration: 1250
    delay: 1250
    repetitions: 5

ipmi:
    # Default: IPMI is not available
    enabled: false

# CPU Temperature Sensor
cpu:
    # Possible Drivers:
    # - ipmi
    # - coretemp
    # - k10temp
    driver: ipmi

    max_temp: 60
    min_temp: 50
    warning_temp: 80
    shutdown_temp: 95

# PCH Temperature Sensor
pch:
    driver: ipmi
    max_temp: 60
    min_temp: 50
    warning_temp: 80
    shutdown_temp: 95

# RAM Temperatures Sensors
ram:
    driver: ipmi
    max_temp: 60
    min_temp: 50
    warning_temp: 80
    shutdown_temp: 95

# Drives Temperatures Sensors
drives:
    # Generic Drive (this will override more loose Requirements from hdd/sdd/nvme !)
    generic:
        # "diskinfo"
        driver: diskinfo
        max_temp: 60
        min_temp: 40
        warning_temp: 70
        shutdown_temp: 80

    # HDD Drive
    hdd:
        # "diskinfo"
        driver: diskinfo
        max_temp: 37
        min_temp: 32
        warning_temp: 50
        shutdown_temp: 55

    # SSD Drive
    ssd:
        # "diskinfo"
        driver: diskinfo
        max_temp: 60
        min_temp: 50
        warning_temp: 65
        shutdown_temp: 75

    # NVME Drive
    nvme:
        # "diskinfo"
        driver: diskinfo
        max_temp: 60
        min_temp: 50
        warning_temp: 65
        shutdown_temp: 75

# GPUs Temperatures Sensors and optional extra Information
gpu:
    # AMD GPUs
    amd:
        # Driver Available: "amdgpu" or "psutil"
        driver: amdgpu

    # NVIDIA GPUs
    nvidia:
        # Driver Available: "nvidia"
        driver: nvidia

    # INTEL GPUs
    intel:
        # Driver Available: "intel"
        driver: intel

# Fan Controller
fan_controller:
    initial_speed: 70
    max_speed: 100
    min_speed: 10
    inc_speed_step: 5
    dec_speed_step: 1

# Fan Speed Measurements
fan_readings:
    driver: ipmi

# PWM Interface
pwm:
    zones:
        - name: pwm1
          description: "CPU Zone"
          driver: ipmi
        - name: pwm2
          description: "Peripherals Zone"
          driver: ipmi

# Web Server (API)
web_server:
    # Web Server Enabled ?
    enabled: true

    # Bind Address / Port
    bind_address: "127.0.0.1"
    bind_port: 8080

    # Authentication
    authentication:
        # Types: oidc, null
        type: null

        # OIDC Configuration
        # client_id: ""
        # client_secret: ""
        # discovery_url: "https://auth.MYDOMAIN.TLD/application/o/<SLUG>/.well-known/openid-configuration"
        # token_url: "https://auth.MYDOMAIN.TLD/application/o/token/"
        # authorize_url: "https://auth.MYDOMAIN.TLD/application/o/authorize/"
        # userinfo_url: "https://auth.MYDOMAIN.TLD/application/o/userinfo/"
