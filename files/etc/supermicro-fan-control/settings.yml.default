general:
    motherboard: "default"
    update_interval: 30
    environment:
        LC_TIME: "en_DK.UTF-8"
        LC_ALL: "en_DK.UTF-8"
    debug: False

log:
    level: "INFO"

beep:
    frequency: 2500
    duration: 1250
    delay: 1250
    repetitions: 5

# Generic CPU
cpu:
    driver: ipmitool
    max_temp: 60
    min_temp: 50
    warning_temp: 80
    shutdown_temp: 95

# Generic Drive
# (!! will override more loose Requirements from hdd/sdd/nvme !!)
drive:
    max_temp: 60
    min_temp: 40
    warning_temp: 70
    shutdown_temp: 80

# HDD Drive
hdd:
    max_temp: 37
    min_temp: 32
    warning_temp: 50
    shutdown_temp: 55

# SSD Drive
ssd:
    max_temp: 60
    min_temp: 50
    warning_temp: 65
    shutdown_temp: 75

# NVME Drive
nvme:
    max_temp: 60
    min_temp: 50
    warning_temp: 65
    shutdown_temp: 75

# Generic Fan
fan:
    initial_speed: 70
    max_speed: 100
    min_speed: 10
    inc_speed_step: 5
    dec_speed_step: 1

# Web Server API
web_server:
    bind_address: "127.0.0.1"
    bind_port: 8080

    # authentication:
    #     # Types: oidc, null
    #     type: oidc

    #     # OIDC Configuration
    #     client_id: ""
    #     client_secret: ""
    #     discovery_url: "https://auth.MYDOMAIN.TLD/application/o/<SLUG>/.well-known/openid-configuration"
    #     token_url: "https://auth.MYDOMAIN.TLD/application/o/token/"
    #     authorize_url: "https://auth.MYDOMAIN.TLD/application/o/authorize/"
    #     userinfo_url: "https://auth.MYDOMAIN.TLD/application/o/userinfo/"
